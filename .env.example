# This is an example .env file.
# Copy this file to .env.local, .env.development.local, or .env.production.local
# and fill in the actual values for your environment.
# IMPORTANT: Files ending in .local are ignored by Git and should NOT be committed.

# Vite specific (optional, Vite has defaults)
# VITE_APP_TITLE=My Awesome App

# API configurations (examples)
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_ANALYTICS_ID=your_analytics_id

# Feature flags (examples)
# VITE_FEATURE_NEW_DASHBOARD=true
